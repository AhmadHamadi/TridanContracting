# Quote-form lead email via Resend (https://resend.com).
# Set these in Vercel -> Settings -> Environment Variables (server-side; never exposed to the browser).
# Reusable across client sites: verify ONE domain in Resend, then per site set LEAD_TO to that client's inbox.

RESEND_API_KEY=          # from resend.com -> API Keys (starts with re_...)
LEAD_FROM=               # an address on your VERIFIED Resend domain, e.g. "Website Leads <leads@yourdomain.com>"
LEAD_TO=                 # where this site's leads go, e.g. tridancontractor@gmail.com

# NOTE: To use Resend, also clear site.formEndpoint in lib/site.ts (set it to '')
# so the form posts to /api/quote instead of the Basin form service.
