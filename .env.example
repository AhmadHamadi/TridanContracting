# Quote-form lead email (SMTP). Set these in Vercel -> Settings -> Environment Variables.
# These are SERVER-side secrets (no NEXT_PUBLIC_ prefix) and are never exposed to the browser.

# Your mail server:
#   GoDaddy Professional Email -> smtpout.secureserver.net
#   Microsoft 365 / Outlook    -> smtp.office365.com  (enable "Authenticated SMTP" for the mailbox)
SMTP_HOST=
SMTP_PORT=465            # 465 = SSL, 587 = STARTTLS
SMTP_USER=               # full email address to send FROM, e.g. you@yourdomain.com
SMTP_PASS=               # that mailbox password (or an app password if MFA is on)

LEAD_TO=                 # where leads are delivered, e.g. tridancontractor@gmail.com
# LEAD_FROM=             # optional: from-address if different from SMTP_USER
